+      // mouth/brow params to their resting "0-neutral" pose which on this
+      // rig looks angry, and overrides motion-driven params like ParamBreath).
+      const inputs: { [k: string]: number } = {
+        FaceAngleX: dx * 30,
+        FaceAngleY: dy * 30,
+        FaceAngleZ: -dx * 30 * 0.5,
+        FacePositionX: dx * 0.3,
+        FacePositionY: dy * 0.3,
+        EyeLeftX: dx,
+        EyeLeftY: dy,
+        EyeRightX: dx,
+        EyeRightY: dy,
+        EyeOpenLeft: 1,
+        EyeOpenRight: 1,
+      };
+      for (const r of this._vtubeRoutings) {
+        if (!(r.input in inputs)) continue;
+        let v = inputs[r.input];
+        if (r.clampInput) {
+          v = Math.max(r.inputLow, Math.min(r.inputHigh, v));
+        }
+        const span = r.inputHigh - r.inputLow;
